ags_by_rule\": hits, \"false_positives_by_rule\": fp_by_rule,\n","         \"rate_sweep\": sweep_list, \"hardware\": HW}\n","    SUMMARY[size] = M\n","    jpath = f\"{LOCAL}/stream_metrics_{size}.json\"\n","    json.dump(M, open(jpath, \"w\"), indent=2, default=lambda o: o.item() if hasattr(o, \"item\") else str(o))\n","    shutil.copy(jpath, f\"{ROOT}/results/stream_metrics_{size}.json\")\n","    shutil.copy(RESULTS[(size, prim)][\"flags_path\"], f\"{ROOT}/results/stream_flags_{size}.csv\")\n","\n","    print(f\"\\n==================== {size.upper()} (headline: {prim:,} ev/s) ====================\")\n","    print(pd.DataFrame([[M['tn'], M['fp']], [M['fn'], M['tp']]], index=[\"actual normal\", \"actual fraud\"],\n","                       columns=[\"pred normal\", \"pred fraud\"]))\n","    print(\"Recall by fraud type:\", recall_by_type)\n","    print(\"Recall by stream decile (0 = earliest 10%):\", by_decile)\n","    print(\"Cold start (high-amount fraud):\", cold_start)\n","    print(\"Flags by rule:\", hits, \"| false positives by rule:\", fp_by_rule)\n","    print(\"Rate sweep (flagged-event latency in ms):\")\n","    display(pd.DataFrame(sweep_list)[[\"replay_rate_eps\", \"producer_achieved_eps\", \"achieved_throughput_eps\",\n","            \"scoring_capacity_eps\", \"latency_median_ms\", \"latency_p95_ms\", \"latency_p99_ms\", \"latency_max_ms\",\n","            \"max_lag_msgs\", \"max_lag_sec\", \"fell_behind\", \"cpu_avg_pct\", \"cpu_peak_pct\", \"mem_peak_mb\"]].set_index(\"replay_rate_eps\"))\n","    print(\"Consumer first falls behind at:\", M[\"saturation_rate_eps\"], \"ev/s\")\n","\n","keys = [\"rows\", \"primary_rate_eps\", \"achieved_throughput_eps\", \"scoring_capacity_eps\", \"latency_median_ms\",\n","        \"latency_p95_ms\", \"latency_p99_ms\", \"latency_max_ms\", \"precision\", \"recall\", \"f1\", \"fpr\",\n","        \"cpu_avg_pct\", \"cpu_peak_pct\", \"mem_avg_mb\", \"mem_peak_mb\", \"saturation_rate_eps\"]\n","print(\"\\n\\n############ STR