)\n","    tp = int(((gt.is_fraud == 1) & (gt_f == 1)).sum()); fp = int(((gt.is_fraud == 0) & (gt_f == 1)).sum())\n","    fn = int(((gt.is_fraud == 1) & (gt_f == 0)).sum()); tn = int(((gt.is_fraud == 0) & (gt_f == 0)).sum())\n","    prec = tp / (tp + fp) if tp + fp else 0.0; rec = tp / (tp + fn) if tp + fn else 0.0\n","    f1 = 2 * prec * rec / (prec + rec) if prec + rec else 0.0; fpr = fp / (fp + tn) if fp + tn else 0.0\n","    ps, cs, res = r[\"producer\"], r[\"consumer\"], r[\"resource\"]\n","    e = {\"replay_rate_eps\": rate, \"producer_achieved_eps\": round(ps[\"achieved_send_rate\"], 1),\n","         \"achieved_throughput_eps\": round(r[\"rows\"] / r[\"total_sec\"], 1),\n","         \"scoring_capacity_eps\": round(cs[\"n_done\"] / cs[\"proc_sec\"], 1), \"total_sec\": round(r[\"total_sec\"], 2),\n","         **lat_stats(fl[\"latency_ms\"], \"latency\"), **lat_stats(np.load(r[\"lat_all_path\"]), \"all_latency\"),\n","         \"max_lag_msgs\": cs[\"max_lag_msgs\"], \"max_lag_sec\": round(cs[\"max_lag_sec\"], 3),\n","         \"fell_behind\": bool(cs[\"max_lag_sec\"] > LAG_THRESHOLD_SEC), \"flagged_rows\": int(len(fl)),\n","         \"tp\": tp, \"fp\": fp, \"fn\": fn, \"tn\": tn, \"precision\": round(prec, 4), \"recall\": round(rec, 4),\n","         \"f1\": round(f1, 4), \"fpr\": round(fpr, 6), **{k: res[k] for k in\n","         [\"cpu_avg_pct\", \"cpu_peak_pct\", \"mem_avg_mb\", \"mem_peak_mb\", \"mem_baseline_mb\"]}}\n","    return e, fl, gt.assign(flagged=gt_f)\n","\n","SUMMARY = {}\n","for size in sorted({s for s, _ in RESULTS}, key=lambda s: CFG[\"datasets\"][s]):\n","    rates = sorted(r for s, r in RESULTS if s == size)\n","    sweep = {rate: evaluate_run(size, rate) for rate in rates}\n","    prim = PRIMARY_RATE if PRIMARY_RATE in sweep else rates[0]\n","    head, fl_head, gt_head = sweep[prim]\n","\n","    fraud = gt_head[gt_head.is_fraud == 1]\n","    recall_by_type = fraud.groupby(\"fraud_type\")[\"flagged\"].mean().round(4).to_dict()\n","    by_decile