200))\n","t_start = time.time()\n","for i, (tid, uid, amt, la, lo, tsv) in enumerate(rows):\n","    if i % chunk == 0:\n","        wait = t_start + i / a.rate - time.time()\n","        if wait > 0:\n","            time.sleep(wait)\n","    payload = '{\"txn_id\":\"%s\",\"user_id\":\"%s\",\"amount\":%s,\"lat\":%s,\"lon\":%s,\"ts\":%d,\"send_ts\":%.6f}' % (\n","        tid, uid, amt, la, lo, tsv, time.time())\n","    while True:\n","        try:\n","            p.produce(a.topic, value=payload, key=uid)\n","            break\n","        except BufferError:\n","            p.poll(0.01)\n","    if i % 100 == 0:\n","        p.poll(0)\n","t_loop_end = time.time()\n","p.flush(60)\n","json.dump({\"events\": n, \"target_rate\": a.rate, \"t_start\": t_start, \"t_loop_end\": t_loop_end,\n","           \"achieved_send_rate\": n / (t_loop_end - t_start)},\n","          open(os.path.join(a.outdir, \"producer_stats.json\"), \"w\"))\n","print(\"producer done:\", n, \"events,\", round(n / (t_loop_end - t_start)), \"ev/s\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"a8xjMX5UbvWP","executionInfo":{"status":"ok","timestamp":1791904856037,"user_tz":-330,"elapsed":13,"user":{"displayName":"GARV HEMNANI","userId":"11458498775121451017"}},"outputId":"a86b2a0b-9b20-4808-e213-c15204223fe5"},"execution_count":5,"outputs":[{"output_type":"stream","name":"stdout","text":["Writing /content/stream_scripts/producer.py\n"]}]},{"cell_type":"code","source":["%%writefile /content/stream_scripts/scorer.py\n","import argparse, json, math, os, time\n","from collections import deque\n","import numpy as np\n","import pandas as pd\n","from confluent_kafka import Consumer, Producer, TopicPartition, OFFSET_BEGINNING\n","\n","ap = argparse.ArgumentParser()\n","ap.add_argument(\"--config\", required=True); ap.add_argument(\"--topic_in\", required=True)\n","ap.add_argument(\"--topic_out\", required=True); ap.add_argument(\"--partitions\", type=int, default=3)\n","ap.add_argument(\"--expected\", type=int, required=True); ap.add_argument(\"--outdir\", required=True)\n","ap.add_argument(\"--idle_timeout\", type=float, default=60.0)\n","a = ap.parse_args()\n","\n","R = json.load(open(a.config))[\"rules\"]\n","Z_THR, MIN_HIST = R[\"zscore\"][\"threshold\"], R[\"zscore\"][\"min_history\"]\n","MAX_TXNS, WIN_SEC = R[\"burst\"][\"max_txns\"], R[\"burst\"][\"window_sec\"]\n","MIN_KM, TRAVEL_SEC = R[\"travel\"][\"min_km\"], R[\"travel\"][\"max_minutes\"] * 60\n","START_H, END_H, ODD_MIN = R[\"odd_hour\"][\"start_hour\"], R[\"odd_hour\"][\"end_hour\"], R[\"odd_hour\"][\"min_amount\"]\n","\n","def haversine(lat1, lon1, lat2, lon2):\n","    p1, p2 = math.radians(lat1), math.radians(lat2)\n","    h = math.sin((p2 - p1) / 2) ** 2 + math.cos(p1) * math.cos(p2) * math.sin(math.radians(lon2 - lon1) / 2) ** 2\n","    return 2 * 6371.0 * math.asin(min(1.0, math.sqrt(h)))\n","\n","state = {}\n","\n","consumer = Consumer({\"bootstrap.servers\": \"localhost:9092\", \"group.id\": \"scorer-%d\" % os.getpid(),\n","                     \"enable.auto.commit\": False, \"fetch.wait.max.ms\": 10, \"auto.offset.reset\": \"earliest\"})\n","consumer.assign([TopicPartition(a.topic_in, p, OFFSET_BEGINNING) for p in range(a.partitions)])\n","alerts = Producer({\"bootstrap.servers\": \"localhost:9092\", \"linger.ms\": 5})\n","\n","for _ in range(10):\n","    consumer.poll(0.2)\n","open(os.path.join(a.outdir, \"ready\"), \"w\").write(\"1\")\n","\n","n_done, proc_sec = 0, 0.0\n","lat_all, flags, lag_samples, last_off = [], [], [], {}\n","min_send, t_first, t_last_done = None, None, None\n","last_msg_t = time.time(); next_lag = 0.0\n","\n","while n_done < a.expected:\n","    msg = consumer.poll(0.05)\n","    now = time.time()\n","    if msg is None:\n","        if now - last_msg_t > a.idle_timeout:\n","            print(\"idle timeout - stopping early\"); break\n","        continue\n","    if msg.error():\n","        continue\n","    last_msg_t = now\n","    t0 = time.perf_counter()\n","    e = json.loads(msg.value())\n","    u, amt, ts, la, lo = e[\"user_id\"], e[\"amount\"], e[\"ts\"], e[\"lat\"], e[\"lon\"]\n","    s = state.get(u)\n","    if s is None:\n","        s = state[u] = [0, 0.0, 0.0, deque(), None, None, None]\n","    reasons = []\n","\n","    n, mean, m2 = s[0], s[1], s[2]\n","    if n >= MIN_HIST and n > 1 and amt > mean + Z_THR * math.sqrt(m2 / (n - 1)):\n","        reasons.append(\"zscore\")\n","    n += 1; d = amt - mean; mean += d / n; m2 += d * (amt - mean)\n","    s[0], s[1], s[2] = n, mean, m2\n","\n","    dq = s[3]; dq.append(ts)\n","    while ts - dq[0] > WIN_SEC:\n","        dq.popleft()\n","    if len(dq) > MAX_TXNS:\n","        reasons.append(\"burst\")\n","\n","    if s[6] is not None and ts - s[6] <= TRAVEL_SEC and haversine(s[4], s[5], la, lo) > MIN_KM:\n","        reasons.append(\"travel\")\n","    s[4], s[5], s[6] = la, lo, ts\n","\n","    hr = (ts // 3600) % 24\n","    if START_H <= hr < END_H and amt >= ODD_MIN:\n","        reasons.append(\"odd_hour\")\n","\n","    done = time.time()\n","    lat_ms = (done - e[\"send_ts\"]) * 1000.0\n","    lat_all.append(lat_ms)\n","    if reasons:\n","        r = \"|\".join(reasons)\n","        flags.append((e[\"txn_id\"], r, e[\"send_ts\"], done, lat_ms))\n","        alerts.produce(a.topic_out, key=u, value=json.dumps(\n","            {\"txn_id\": e[\"txn_id\"], \"reasons\": r, \"send_ts\": e[\"send_ts\"], \"flag_ts\": done}))\n","        alerts.poll(0)\n","    proc_sec += time.perf_counter() - t0\n","    n_done += 1\n","    last_off[msg.partition()] = msg.offset() + 1\n","    if min_send is None or e[\"send_ts\"] < min_send:\n","        min_send = e[\"send_ts\"]\n","    t_last_done = done\n","    if t_first is None:\n","        t_first = done\n","\n","    if done >= next_lag:\n","        lag_msgs = 0\n","        for p in range(a.partitions):\n","            lo_w, hi_w = consumer.get_watermark_offsets(TopicPartition(a.topic_in, p), timeout=2.0, cached=False)\n","            lag_msgs += max(0, hi_w - last_off.get(p, 0))\n","        lag_samples.append([round(done - t_first, 2), int(lag_msgs), round(lat_ms / 1000.0, 4)])\n","        next_lag = done + 1.0\n","\n","alerts.flush(10); consumer.close()\n","pd.DataFrame(flags, columns=[\"txn_id\", \"flag_reasons\", \"send_ts\", \"flag_ts\", \"latency_ms\"]).to_csv(\n","    os.path.join(a.outdir, \"flags.csv\"), index=False)\n","np.save(os.path.join(a.outdir, \"lat_all.npy\"), np.array(lat_all, dtype=np.float32))\n","json.dump({\"n_done\": n_done, \"proc_sec\": proc_sec, \"t_first_send\": min_send, \"t_last_done\": t_last_done,\n","           \"max_lag_msgs\": max([x[1] for x in lag_samples] or [0]),\n","           \"max_lag_sec\": max([x[2] for x in lag_samples] or [0.0]),\n","           \"lag_samples\": lag_samples},\n","          open(os.path.join(a.outdir, \"consumer_stats.json\"), \"w\"))\n","print(\"scorer done:\", n_done, \"events,\", len(flags), \"flagged\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"oZB8PwinbxkR","executionInfo":{"status":"ok","timestamp":1791904856047,"user_tz":-330,"elapsed":8,"user":{"displayName":"GARV HEMNANI","userId":"11458498775121451017"}},"outputId":"8baf204e-8780-44e0-ff8f-b6ba2dcb92bb"},"execution_count":6,"outputs":[{"output_type":"stream","name":"stdout","text":["Writing /content/stream_scripts/scorer.py\n"]}]},{"cell_type":"code","source":["class ResourceMonitor:\n","    def __init__(self, interval=0.5):\n","        self.interval, self.cpu, self.mem = interval, [], []\n","        self._stop = threading.Event()\n","    def _run(self):\n","        psutil.cpu_percent(interval=None)\n","        while not self._stop.is_set():\n","            time.sleep(self.interval)\n","            self.cpu.append(psutil.cpu_percent(interval=None))\n","            self.mem.append(psutil.virtual_memory().used / 1e6)\n","    def start(self):\n","        self.base_mem = psutil.virtual_memory().used / 1e6\n","        self._t = threading.Thread(target=self._run, daemon=True); self._t.start()\n","    def stop(self):\n","        self._stop.set(); self._t.join()\n","        cpu = self.cpu or [0.0]; mem = self.mem or [self.base_mem]\n","        return {\"cpu_avg_pct\": round(float(np.mean(cpu)), 1), \"cpu_peak_pct\": round(float(np.max(cpu)), 1),\n","                \"mem_avg_mb\": round(float(np.mean(mem)), 0), \"mem_peak_mb\": round(float(np.max(mem)), 0),\n","                \"mem_baseline_mb\": round(self.base_mem, 0), \"samples\": len(cpu)}\n","\n","def show_log(path):\n","    if os.path.exists(path): print(open(path).read()[-2500:])\n","\n","def run_stream(size, rate):\n","    csv_local = f\"{LOCAL}/transactions_{size}.csv\"\n","    if not os.path.exists(csv_local):\n","        shutil.copy(f\"{ROOT}/data/transactions_{size}.csv\", csv_local)\n","    n_rows = sum(1 for _ in open(csv_local)) - 1\n","    tag = f\"{size}_{rate}\"\n","    t_in, t_out = f\"{TOPIC_IN}-{size}-{rate}\", f\"{TOPIC_OUT}-{size}-{rate}\"\n","    outdir = f\"{LOCAL}/run_{tag}\"; shutil.rmtree(outdir, ignore_errors=True); os.makedirs(outdir)\n","    print(f\"\\n=== Stream | {size} | {n_rows:,} rows | replay {rate:,} ev/s ===\")\n","    create_topics([t_in, t_out])\n","\n","    cons = subprocess.Popen([sys.executable, f\"{SCRIPT}/scorer.py\", \"--config\", f\"{LOCAL}/config.json\",\n","                             \"--topic_in\", t_in, \"--topic_out\", t_out, \"--partitions\", str(PARTS),\n","                             \"--expected\", str(n_rows), \"--outdir\", outdir],\n","                            stdout=open(f\"{outdir}/consumer.log\", \"w\"), stderr=subprocess.STDOUT)\n","    for _ in range(120):\n","        if os.path.exists(f\"{outdir}/ready\"): break\n","        if cons.poll() is not None:\n","            show_log(f\"{outdir}/consumer.log\"); raise RuntimeError(\"scorer crashed at startup\")\n","        time.sleep(0.5)\n","    else:\n","        cons.kill(); raise RuntimeError(\"scorer never became ready\")\n","\n","    mon = ResourceMonitor(); m